+package com.brentvatne.exoplayer
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.os.Build
+import android.text.Layout
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.StaticLayout
+import android.text.TextPaint
+import android.text.style.BackgroundColorSpan
+import android.text.style.ForegroundColorSpan
+import android.util.AttributeSet
+import android.util.TypedValue
+import android.view.View
+import android.view.ViewGroup
+import androidx.media3.common.text.Cue
+import com.brentvatne.common.api.SubtitleStyle
+
+class CustomSubtitleOverlayView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : View(context, attrs, defStyleAttr) {
+
+    private var cues: List<Cue> = emptyList()
+    private var style = SubtitleStyle()
+
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        isSubpixelText = true
+    }
+    private val strokePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        isSubpixelText = true
+        style = Paint.Style.STROKE
+        strokeJoin = Paint.Join.ROUND
+        strokeCap = Paint.Cap.ROUND
+    }
+    private val bgPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    fun setCues(newCues: List<Cue>) {
+        this.cues = newCues
+        postInvalidate()
+    }
+
+    fun setStyle(newStyle: SubtitleStyle) {
+        this.style = newStyle
+        postInvalidate()
+    }
+
+    private fun createEdgeText(source: CharSequence): CharSequence {
+        if (source !is Spanned) return source
+        val spannable = SpannableStringBuilder(source)
+        val fgSpans = spannable.getSpans(0, spannable.length, ForegroundColorSpan::class.java)
+        for (span in fgSpans) {
+            spannable.removeSpan(span)
+        }
+        val bgSpans = spannable.getSpans(0, spannable.length, BackgroundColorSpan::class.java)
+        for (span in bgSpans) {
+            spannable.removeSpan(span)
+        }
+        return spannable
+    }
+
+    private fun cleanCueText(source: CharSequence): CharSequence {
+        if (source !is Spanned) return source
+        val spannable = SpannableStringBuilder(source)
+        val bgSpans = spannable.getSpans(0, spannable.length, BackgroundColorSpan::class.java)
+        for (span in bgSpans) {
+            spannable.removeSpan(span)
+        }
+        return spannable
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (cues.isEmpty()) return
+
+        val density = resources.displayMetrics.density
+        val fontSizeSp = if (style.fontSize > 0) style.fontSize.toFloat() else 16f
+        val textSizePx = TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_SP,
+            fontSizeSp,
+            resources.displayMetrics
+        )
+
+        val typeface = when (style.fontFamily) {
+            "sans-serif" -> Typeface.SANS_SERIF
+            "serif" -> Typeface.SERIF
+            "monospace" -> Typeface.MONOSPACE
+            "casual" -> Typeface.create("casual", Typeface.NORMAL)
+            "cursive" -> Typeface.create("cursive", Typeface.NORMAL)
+            else -> Typeface.DEFAULT
+        }
+
+        textPaint.typeface = typeface
+        textPaint.textSize = textSizePx
+
+        strokePaint.typeface = typeface
+        strokePaint.textSize = textSizePx
+
+        val fgColor = try {
+            if (!style.textColor.isNullOrEmpty()) Color.parseColor(style.textColor) else Color.WHITE
+        } catch (e: Exception) {
+            Color.WHITE
+        }
+
+        val edColor = try {
+            if (!style.edgeColor.isNullOrEmpty()) Color.parseColor(style.edgeColor) else Color.BLACK
+        } catch (e: Exception) {
+            Color.BLACK
+        }
+
+        val bgAlpha = if (style.opacity in 0.0f..1.0f) (style.opacity * 255).toInt() else 0
+        val edgeType = style.edgeType ?: "outline"
+        val outlineWidthPx = style.outlineWidth.toFloat() * density
+        val bottomPaddingPx = style.paddingBottom.toFloat() * density
+
+        val contentFrame = (parent as? ViewGroup)?.findViewById<View>(androidx.media3.ui.R.id.exo_content_frame)
+        val followVideo = style.subtitlesFollowVideo && contentFrame != null && contentFrame.width > 0 && contentFrame.height > 0
+        val videoLeft = if (followVideo) contentFrame!!.left.toFloat() else 0f
+        val videoTop = if (followVideo) contentFrame!!.top.toFloat() else 0f
+        val videoWidth = if (followVideo) contentFrame!!.width.toFloat() else width.toFloat()
+        val videoHeight = if (followVideo) contentFrame!!.height.toFloat() else height.toFloat()
+        val videoBottom = if (followVideo) videoTop + videoHeight else height.toFloat()
+
+        if (videoWidth <= 0 || videoHeight <= 0) return
+
+        val maxTextWidth = (videoWidth - (48 * density)).toInt().coerceAtLeast(10)
+
+        // Render each cue
+        for (cue in cues) {
+            val rawText = cue.text ?: continue
+            if (rawText.isEmpty()) continue
+
+            val text = cleanCueText(rawText)
+            val edgeText = createEdgeText(rawText)
+
+            textPaint.style = Paint.Style.FILL
+            textPaint.color = fgColor
+
+            val staticLayout = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                StaticLayout.Builder.obtain(text, 0, text.length, textPaint, maxTextWidth)
+                    .setAlignment(Layout.Alignment.ALIGN_CENTER)
+                    .setLineSpacing(0f, 1.15f)
+                    .setIncludePad(false)
+                    .build()
+            } else {
+                @Suppress("DEPRECATION")
+                StaticLayout(text, textPaint, maxTextWidth, Layout.Alignment.ALIGN_CENTER, 1.15f, 0f, false)
+            }
+
+            var minLineLeft = Float.MAX_VALUE
+            var maxLineRight = Float.MIN_VALUE
+            for (i in 0 until staticLayout.lineCount) {
+                minLineLeft = minOf(minLineLeft, staticLayout.getLineLeft(i))
+                maxLineRight = maxOf(maxLineRight, staticLayout.getLineRight(i))
+            }
+            if (minLineLeft > maxLineRight) {
+                minLineLeft = 0f
+                maxLineRight = staticLayout.width.toFloat()
+            }
+
+            val textHeight = staticLayout.height.toFloat()
+            val padH = 12f * density
+            val padV = 5f * density
+
+            val x = videoLeft + (videoWidth - maxTextWidth) / 2f
+            val boxLeft = x + minLineLeft - padH
+            val boxRight = x + maxLineRight + padH
+            val boxHeight = textHeight + padV * 2
+            val boxBottom = videoBottom - bottomPaddingPx - (4f * density)
+            val boxTop = boxBottom - boxHeight
+            val y = boxTop + padV
+
+            // Draw background rounded box
+            if (bgAlpha > 0) {
+                bgPaint.color = Color.argb(bgAlpha, 0, 0, 0)
+                val bgRect = RectF(boxLeft, boxTop, boxRight, boxBottom)
+                canvas.drawRoundRect(bgRect, 8f * density, 8f * density, bgPaint)
+            }
+
+            // Draw edge effects
+            when (edgeType) {
+                "outline" -> {
+                    if (outlineWidthPx > 0f) {
+                        strokePaint.strokeWidth = outlineWidthPx * 2f
+                        strokePaint.color = edColor
