+                String[] firstAndLast = rangeAndTotal[0].split("-");
+                return new long[] {
+                        Long.parseLong(firstAndLast[0].trim()),
+                        Long.parseLong(firstAndLast[1].trim()),
+                        Long.parseLong(rangeAndTotal[1].trim()),
