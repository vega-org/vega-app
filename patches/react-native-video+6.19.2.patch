+                    || !entry.getKey().equalsIgnoreCase("Content-Range")
+                    || entry.getValue().isEmpty()) {
+                continue;
+            }
+            String value = entry.getValue().get(0).trim().toLowerCase(Locale.US);
+            if (!value.startsWith("bytes ")) {
+                return null;
+            }
+            try {
