+        }
+        return length;
+    }
+
+    @Override
+    public int read(byte[] buffer, int offset, int length) throws IOException {
+        if (length == 0) {
+            return 0;
+        }
+        if (engine != null) {
+            try {
+                int read = engine.read(buffer, offset, length);
+                if (read > 0) {
+                    position += read;
+                }
+                return read;
+            } catch (FallbackException fallback) {
+                Log.i(TAG, "Back to one connection: " + fallback.getMessage());
+                engine.close();
+                engine = null;
+                reopenSingle();
+            }
+        }
