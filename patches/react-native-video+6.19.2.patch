+            Map<String, List<String>> headers, long start, long end, long totalLength) {
+        long[] range = parseContentRange(headers);
+        return range != null
+                && range[0] == start
+                && range[1] == end - 1
+                && (totalLength <= 0 || range[2] == totalLength);
+    }
