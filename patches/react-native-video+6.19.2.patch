+package com.brentvatne.exoplayer
+
+import android.animation.ValueAnimator
+import android.view.animation.DecelerateInterpolator
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.os.Build
+import android.text.Layout
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.StaticLayout
+import android.text.TextPaint
+import android.text.style.BackgroundColorSpan
+import android.text.style.ForegroundColorSpan
+import android.util.AttributeSet
+import android.util.TypedValue
+import android.view.View
+import android.view.ViewGroup
+import androidx.media3.common.text.Cue
+import com.brentvatne.common.api.SubtitleStyle
+
+class CustomSubtitleOverlayView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : View(context, attrs, defStyleAttr) {
+
+    private var cues: List<Cue> = emptyList()
+    private var style = SubtitleStyle()
+    private var animatedBottomPadding = 0f
+    private var paddingAnimator: ValueAnimator? = null
+    private var hasStyle = false
+
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        isSubpixelText = true
+    }
+    private val strokePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        isSubpixelText = true
+        style = Paint.Style.STROKE
+        strokeJoin = Paint.Join.ROUND
+        strokeCap = Paint.Cap.ROUND
+    }
+    private val bgPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val bitmapPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+
+    fun setCues(newCues: List<Cue>) {
+        this.cues = newCues
+        postInvalidate()
+    }
+
+    fun setStyle(newStyle: SubtitleStyle) {
+        val targetPadding = newStyle.paddingBottom.toFloat()
+        val paddingChanged = style.paddingBottom != newStyle.paddingBottom
+        this.style = newStyle
+        if (!hasStyle || !isAttachedToWindow) {
+            paddingAnimator?.cancel()
+            animatedBottomPadding = targetPadding
+        } else if (paddingChanged) {
+            paddingAnimator?.cancel()
+            paddingAnimator = ValueAnimator.ofFloat(animatedBottomPadding, targetPadding).apply {
+                duration = 350L
+                interpolator = DecelerateInterpolator()
+                addUpdateListener {
+                    animatedBottomPadding = it.animatedValue as Float
+                    invalidate()
+                }
+                start()
+            }
+        }
+        hasStyle = true
+        postInvalidate()
+    }
+
+    override fun onDetachedFromWindow() {
+        paddingAnimator?.cancel()
+        paddingAnimator = null
+        animatedBottomPadding = style.paddingBottom.toFloat()
+        super.onDetachedFromWindow()
+    }
+
+    private fun createEdgeText(source: CharSequence): CharSequence {
