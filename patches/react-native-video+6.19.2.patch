+public final class ParallelDataSource implements DataSource {
+    private static final String TAG = "VegaParallelStream";
+
+    static final int MAX_CONNECTIONS = 4;
+    /** Below this, one connection is likely too slow for high bitrate video. */
+    static final long SLOW_BYTES_PER_SECOND = 1_500_000L;
+    private static final long MEASURE_MIN_NANOS = 3_000_000_000L;
+    private static final long MEASURE_MIN_BYTES = 512 * 1024L;
+    private static final int FIRST_CHUNK_BYTES = 1024 * 1024;
+    private static final int MAX_CHUNK_BYTES = 8 * 1024 * 1024;
