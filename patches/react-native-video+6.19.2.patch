+package com.brentvatne.exoplayer;
+
+import androidx.media3.common.C;
+import androidx.media3.common.audio.BaseAudioProcessor;
+import java.nio.ByteBuffer;
+
+/** Remains in the PCM chain so changing gain never requires a seek or sink rebuild. */
+public final class VolumeBoostAudioProcessor extends BaseAudioProcessor {
+    private final DelayRenderersFactory.Delays state;
+    private float lastReportedGain = 1f;
+
+    public VolumeBoostAudioProcessor(DelayRenderersFactory.Delays state) {
+        this.state = state;
+    }
+
+    @Override
+    protected AudioFormat onConfigure(AudioFormat input) throws UnhandledAudioFormatException {
+        if (input.encoding != C.ENCODING_PCM_16BIT) throw new UnhandledAudioFormatException(input);
+        return input;
+    }
+
+    @Override
+    public void queueInput(ByteBuffer input) {
+        // The pipeline can pass our drained output back as empty input. Check before
+        // replaceOutputBuffer clears the reusable buffer (which may be that input).
+        if (!input.hasRemaining()) return;
+        float gain = state.volumeGain;
+        ByteBuffer output = replaceOutputBuffer(input.remaining());
+        PcmVolumeGain.process(input, output, gain);
+        // Only log transitions to either endpoint, never each frame or gesture step.
+        if ((gain == 1f || gain == 2f) && gain != lastReportedGain) {
+            android.util.Log.i("VegaVolumeBoost", "PCM gain=" + gain
+                    + " channels=" + inputAudioFormat.channelCount);
+            lastReportedGain = gain;
+        }
+        output.flip();
+    }
+}
