+package com.brentvatne.exoplayer;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Per-player gain for interleaved PCM; every channel is amplified equally. */
+public final class PcmVolumeGain {
+    private PcmVolumeGain() { }
+
+    public static void process(ByteBuffer input, ByteBuffer output, float gain) {
+        input.order(ByteOrder.LITTLE_ENDIAN);
+        output.order(ByteOrder.LITTLE_ENDIAN);
+        if (gain == 1f) {
+            output.put(input);
+            return;
+        }
+        while (input.remaining() >= 2) {
+            int amplified = Math.round(input.getShort() * gain);
+            output.putShort((short) Math.max(Short.MIN_VALUE, Math.min(Short.MAX_VALUE, amplified)));
+        }
+    }
+}
