+                @NonNull Format[] formats,
+                @NonNull SampleStream stream,
+                long positionUs,
+                boolean joining,
+                boolean mayRenderStartOfStream,
+                long startPositionUs,
+                long offsetUs,
+                @NonNull MediaSource.MediaPeriodId mediaPeriodId) throws ExoPlaybackException {
