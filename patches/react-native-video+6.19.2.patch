@@ -0,0 +1,50 @@
+package com.brentvatne.exoplayer;
+
+import android.net.Uri;
+import androidx.annotation.Nullable;
+import androidx.media3.common.ParserException;
+import androidx.media3.exoplayer.hls.playlist.DefaultHlsPlaylistParserFactory;
+import androidx.media3.exoplayer.hls.playlist.HlsMediaPlaylist;
+import androidx.media3.exoplayer.hls.playlist.HlsMultivariantPlaylist;
+import androidx.media3.exoplayer.hls.playlist.HlsPlaylist;
+import androidx.media3.exoplayer.hls.playlist.HlsPlaylistParserFactory;
+import androidx.media3.exoplayer.upstream.ParsingLoadable;
+
+/** Prevent Media3's LL-HLS error handler from querying opaque playlist URIs. */
+public final class SafeHlsPlaylistParserFactory implements HlsPlaylistParserFactory {
+    private final HlsPlaylistParserFactory delegate = new DefaultHlsPlaylistParserFactory();
+
+    @Override
+    public ParsingLoadable.Parser<HlsPlaylist> createPlaylistParser() {
+        return guarded(delegate.createPlaylistParser());
+    }
+
+    @Override
+    public ParsingLoadable.Parser<HlsPlaylist> createPlaylistParser(
+            HlsMultivariantPlaylist master, @Nullable HlsMediaPlaylist previous) {
+        return guarded(delegate.createPlaylistParser(master, previous));
+    }
+
+    static ParsingLoadable.Parser<HlsPlaylist> guarded(ParsingLoadable.Parser<HlsPlaylist> parser) {
+        return (uri, input) -> {
+            // Check before parsing; a direct media playlist is otherwise promoted
+            // to a synthetic master referencing this same opaque URI.
+            requireHierarchical(uri);
+            HlsPlaylist playlist = parser.parse(uri, input);
+            if (playlist instanceof HlsMultivariantPlaylist) {
+                for (Uri url : ((HlsMultivariantPlaylist) playlist).mediaPlaylistUrls) {
+                    requireHierarchical(url);
+                }
+            }
+            return playlist;
+        };
+    }
+
+    private static void requireHierarchical(Uri uri) throws ParserException {
+        if (!uri.isHierarchical()) {
+            // Do not include data URIs or signed URLs in the error/log.
+            throw ParserException.createForMalformedManifest(
+                    "Unsupported opaque HLS playlist URI; try another server", null);
+        }
+    }
+}
